{
  "expo": {
    "name": "CallsVideo Provider",
    "slug": "callsvideoprovider",
    "scheme": "callsvideoprovider",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.callsvideo.provider",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.DISABLE_KEYGUARD",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
  [
    "expo-notifications",
    {
      "icon": "./assets/icon.png",
      "color": "#4f8ef7",
      "defaultChannel": "incoming_calls",
      "sounds": ["./assets/ringtone.mp3"]
    }
  ],
  "@react-native-firebase/app",
  "@react-native-firebase/messaging",
  "./plugins/withCallKeep.js",
  "@config-plugins/react-native-webrtc"
],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#4f8ef7",
      "androidMode": "default",
      "androidCollapsedTitle": "CallsVideo"
    },
    "extra": {
      "eas": {
        "projectId": "ba576808-972f-4bf3-8935-0029be335bfc"
      }
    }
  }
}